# ==========================================
# Payroll Insight Pro - Environment Configuration Template
# ==========================================

# Database Connection (PostgreSQL)
# ------------------------------------------
DB_URL="jdbc:postgresql://localhost:5432/payroll_insight_db"
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"
DB_MAX_POOL_SIZE=10

# Optional Initial Admin User (Leave blank to use existing database users)
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_ADMIN_NAME=""

# JWT Token Configuration
JWT_SECRET="your_production_256_bit_jwt_secret_key"
JWT_ISSUER="com.payroll.insight"
JWT_AUDIENCE="payroll-app-users"
JWT_REALM="Payroll Insight Pro"

# Application Server Port
PORT=8080
HOST="0.0.0.0"
