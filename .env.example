# ==========================================
# Payroll Insight Pro - Environment Configuration Template
# ==========================================

# Database Connection (PostgreSQL)
# ------------------------------------------
DB_URL="jdbc:postgresql://localhost:5432/payroll_insight_db"
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"
DB_MAX_POOL_SIZE=10

# Default Admin User Credentials for Initial Seeding
DEFAULT_ADMIN_EMAIL="admin@institution.gov"
DEFAULT_ADMIN_PASSWORD="your_strong_admin_password"
DEFAULT_ADMIN_NAME="System Administrator"

# JWT Token Configuration
JWT_SECRET="your_production_256_bit_jwt_secret_key"
JWT_ISSUER="com.payroll.insight"
JWT_AUDIENCE="payroll-app-users"
JWT_REALM="Payroll Insight Pro"

# Application Server Port
PORT=8080
HOST="0.0.0.0"
