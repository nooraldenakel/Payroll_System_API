    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    const token = res.data.accessToken || res.data.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "        try { pm.environment.set('authToken', token); } catch(e) {}",
                  "    }",
                  "    if (res.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "        try { pm.environment.set('refreshToken', res.data.refreshToken); } catch(e) {}",
                  "    }",
                  "    console.log('Saved 24h authToken and 7d refreshToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@institution.gov\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate institutional credentials with BCrypt verification. Generates 24-hour access token and 7-day refresh token."
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    const token = res.data.accessToken || res.data.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "        try { pm.environment.set('authToken', token); } catch(e) {}",
                  "    }",
                  "    if (res.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "        try { pm.environment.set('refreshToken', res.data.refreshToken); } catch(e) {}",
                  "    }",
                  "    console.log('Rotated access token and refresh token successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Exchange a valid 7-day refresh token for a newly generated 24-hour access token and rotated refresh token."
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
